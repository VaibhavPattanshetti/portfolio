# Groq API Keys (Supports multiple keys separated by a comma for automatic rotation/failover)
# Get free keys at: https://console.groq.com/keys
GROQ_API_KEYS=gsk_key1_here,gsk_key2_here
GROQ_API_KEY=

# Model to use on Groq
MODEL_NAME=openai/gpt-oss-120b

# Allowed origins for CORS (comma-separated or * for all)
ALLOWED_ORIGINS=*

# Port for the server (defaults to 8000)
PORT=8000
